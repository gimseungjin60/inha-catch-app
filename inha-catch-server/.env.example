# ==================================================================
# Inha-Catch 서버 환경변수 템플릿
# 이 파일을 복사하여 '.env'로 만들고 실제 값을 채워넣으세요.
# .env 는 .gitignore 에 의해 Git에 커밋되지 않습니다.
# ==================================================================

# -------- JWT --------
# 256bit 이상 Base64 문자열. 생성: openssl rand -base64 48
JWT_SECRET=

# -------- Database (MySQL) --------
DB_URL=jdbc:mysql://localhost:3306/inha_catch?serverTimezone=Asia/Seoul&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# -------- Gemini API --------
# https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=

# -------- Kakao OAuth --------
# https://developers.kakao.com 앱 설정 → REST API 키
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback

# -------- Firebase FCM (Phase 3) --------
# Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 비공개 키 생성
# 다운받은 JSON 파일의 절대경로
FIREBASE_SERVICE_ACCOUNT_PATH=

# -------- Server --------
SERVER_PORT=8080

# -------- 초기 관리자 계정 --------
# 서버 첫 기동 시 지정된 이메일로 관리자 계정이 없으면 자동 생성합니다.
# 두 값 모두 비워두면 초기 관리자 자동 생성이 비활성화됩니다.
# 첫 로그인 후 반드시 비밀번호를 변경하세요.
ADMIN_INIT_EMAIL=
ADMIN_INIT_PASSWORD=
ADMIN_INIT_NAME=관리자
