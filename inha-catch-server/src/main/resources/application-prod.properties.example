# ============================================================
# 운영(prod) 프로필 설정 예시.
# 실제 운영 배포 시 이 파일을 application-prod.properties 로 복사하고,
# 또는 (권장) 환경변수로 주입하세요.
#
# 활성화: SPRING_PROFILES_ACTIVE=prod
# ============================================================

# ── DB (운영 RDB) ──────────────────────────────────────
# 환경변수 주입 권장 — 비밀번호를 파일에 평문 저장하지 말 것.
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# 운영에서는 ddl-auto=none + 마이그레이션 도구(Flyway/Liquibase) 사용 권장
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false

# ── JWT Secret ──────────────────────────────────────────
# 반드시 운영 전용 secret 으로 생성: openssl rand -base64 48
jwt.secret=${JWT_SECRET}

# ── Kakao OAuth ─────────────────────────────────────────
kakao.client-id=${KAKAO_CLIENT_ID}
kakao.redirect-uri=${KAKAO_REDIRECT_URI}

# ── Gemini API ──────────────────────────────────────────
gemini.api.key=${GEMINI_API_KEY}

# ── CORS ────────────────────────────────────────────────
# ⚠️ 운영에서는 wildcard(*) 금지. 정확한 어드민/모바일 도메인만 등록.
# 예시: https://admin.inha-catch.kr,https://app.inha-catch.kr
cors.allowed-origins=${CORS_ALLOWED_ORIGINS}

# ── Firebase FCM ────────────────────────────────────────
firebase.config.file=${FIREBASE_CONFIG_FILE:/etc/inha-catch/firebase-service-account.json}

# ── Tomcat 보안/성능 ────────────────────────────────────
server.tomcat.max-http-form-post-size=1048576
server.tomcat.connection-timeout=20000
server.forward-headers-strategy=framework

# (선택) HTTPS 강제 — 운영 LB/리버스 프록시에서 처리하는 게 일반적
# server.ssl.enabled=true
