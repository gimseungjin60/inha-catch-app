# ==================================================================
# Inha-Catch 앱 환경변수 템플릿
# EXPO_PUBLIC_* 접두어가 붙은 변수만 클라이언트 번들에 포함됩니다.
# ==================================================================

# 백엔드 API 주소 (설정 시 모든 플랫폼에서 최우선 사용. 개발 기본값은 자동 fallback)
# iOS 시뮬레이터: http://localhost:8080
# Android 에뮬레이터: http://10.0.2.2:8080
# 실기기(LAN): http://192.168.x.x:8080  ← 컴퓨터 IP
# 프로덕션: https://api.inhacatch.app
EXPO_PUBLIC_API_URL=

# (개발 전용) iOS 실기기/시뮬레이터에서 로컬 서버 접속용 개발자 PC의 LAN IP.
# EXPO_PUBLIC_API_URL 이 비어 있을 때만 iOS 폴백으로 사용됩니다 (api/axios.ts).
# Android 에뮬레이터(10.0.2.2)·웹(localhost) 폴백에는 영향 없음. (ipconfig / ifconfig 로 확인)
EXPO_PUBLIC_LOCAL_IP=172.20.10.5

# Kakao 네이티브 앱 키 (Phase 3)
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# Sentry DSN (Phase 2)
EXPO_PUBLIC_SENTRY_DSN=
